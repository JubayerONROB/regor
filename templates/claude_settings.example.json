{
  "_comment": "Copy to <project>/.claude/settings.json. Denies the assistant the commands that must stay with the researcher. Pattern matching is by command prefix: also deny any wrapper you use (e.g. .venv/Scripts/research.exe approve).",
  "permissions": {
    "deny": [
      "Bash(research approve:*)",
      "Bash(research proposals approve:*)",
      "Bash(research proposals reject:*)",
      "Bash(research hypothesis set:*)",
      "Bash(research loop review:*)",
      "Bash(research approvals revoke:*)",
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(kaggle kernels push:*)",
      "Bash(kaggle datasets create:*)",
      "Bash(kaggle datasets version:*)",
      "Read(./**/pat.txt)",
      "Read(./**/.env)",
      "Read(./**/kaggle*.json)"
    ],
    "ask": [
      "Bash(research run:*)",
      "Bash(research remote collect:*)",
      "Bash(research decision add:*)",
      "Bash(git commit:*)",
      "Bash(rm:*)"
    ]
  }
}
