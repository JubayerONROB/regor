{
  "_comment": "Copy to <project>/.claude/settings.json. Denies the assistant the commands that must stay with the researcher. Pattern matching is by command prefix: also deny any wrapper you use (e.g. .venv/Scripts/regor.exe approve).",
  "permissions": {
    "deny": [
      "Bash(regor approve:*)",
      "Bash(regor proposals approve:*)",
      "Bash(regor proposals reject:*)",
      "Bash(regor hypothesis set:*)",
      "Bash(regor loop review:*)",
      "Bash(regor approvals revoke:*)",
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(kaggle kernels push:*)",
      "Bash(kaggle datasets create:*)",
      "Bash(kaggle datasets version:*)",
      "Read(./**/pat.txt)",
      "Read(./**/.env)",
      "Read(./**/kaggle*.json)"
    ],
    "ask": [
      "Bash(regor run:*)",
      "Bash(regor remote collect:*)",
      "Bash(regor decision add:*)",
      "Bash(git commit:*)",
      "Bash(rm:*)"
    ]
  }
}
